    "@oslojs/encoding": "^1",
    "@workspace/contract": "workspace:*",
    "@workspace/infra": "workspace:*",
    "commander": "^14",
    "drizzle-orm": "^0.45",
    "hono": "^4",
    "iroh-fetch": "0.6.4",
    "picocolors": "^1",
    "pino": "^9",
    "yaml": "2",
    "zod": "^4.6.0",
    "@workspace/providers": "workspace:*"
